# NODO local hardening template for slice_11.
# Copy to .env.local for local-only runs. Do not put real secrets here.

APP_ENV=local
APP_NAME=NODO
APP_VERSION=0.0.0-slice-11-local
NODO_BUILD_ID=slice-11-local-hardening
API_CORS_ORIGINS=http://localhost:3000

# Local Docker Compose services only.
DATABASE_URL=postgresql://nodo_local:nodo_local_password@127.0.0.1:55432/nodo_local
NODO_DB_POOL_MAX_SIZE=50
NODO_DB_POOL_TIMEOUT_SECONDS=20
NODO_DB_POOL_WARM_SIZE=8
REDIS_URL=redis://127.0.0.1:56379/0

# Synthetic local values only. Never use production Telegram/JWT/Stripe secrets here.
BOT_TOKEN=123456:local-hardening-bot-token
BUSINESS_INTAKE_BOT_TOKEN=123456:local-business-intake-bot-token
JWT_SECRET=local-hardening-access-secret-change-me
JWT_REFRESH_SECRET=local-hardening-refresh-secret-change-me
STRIPE_SECRET_KEY=sk_test_local_hardening_placeholder
STRIPE_WEBHOOK_SECRET=whsec_local_hardening_placeholder

AUTH_INIT_DATA_MAX_AGE_SECONDS=86400
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
AUTH_RATE_LIMIT_MAX_ATTEMPTS=1000
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
BUSINESS_RATE_LIMIT_MAX_ATTEMPTS=1000
BUSINESS_RATE_LIMIT_WINDOW_SECONDS=60
CHAT_MESSAGE_RATE_LIMIT_MAX_ATTEMPTS=10
CHAT_MESSAGE_RATE_LIMIT_WINDOW_SECONDS=60
CHAT_DUPLICATE_MESSAGE_RATE_LIMIT_MAX_ATTEMPTS=2
CHAT_DUPLICATE_MESSAGE_RATE_LIMIT_WINDOW_SECONDS=60
CHAT_ATTACHMENT_RATE_LIMIT_MAX_ATTEMPTS=6
CHAT_ATTACHMENT_RATE_LIMIT_WINDOW_SECONDS=60
SUPPORT_MESSAGE_RATE_LIMIT_MAX_ATTEMPTS=10
SUPPORT_MESSAGE_RATE_LIMIT_WINDOW_SECONDS=60
SUPPORT_DUPLICATE_MESSAGE_RATE_LIMIT_MAX_ATTEMPTS=2
SUPPORT_DUPLICATE_MESSAGE_RATE_LIMIT_WINDOW_SECONDS=60
SUPPORT_ATTACHMENT_RATE_LIMIT_MAX_ATTEMPTS=6
SUPPORT_ATTACHMENT_RATE_LIMIT_WINDOW_SECONDS=60
MARKETPLACE_RATE_LIMIT_MAX_ATTEMPTS=1000
MARKETPLACE_RATE_LIMIT_IP_MAX_ATTEMPTS=2000
MARKETPLACE_RATE_LIMIT_WINDOW_SECONDS=60
MARKETPLACE_CACHE_TTL_SECONDS=30
MARKETPLACE_READ_AUTH_CLAIM_TTL_SECONDS=300
AUTH_USER_CACHE_TTL_SECONDS=2
API_THREAD_LIMIT=40
OBSERVABILITY_INGEST_ENABLED=0
OBSERVABILITY_MAX_EVENTS_PER_BATCH=20
OBSERVABILITY_MAX_EVENT_BYTES=2048
OBSERVABILITY_RATE_LIMIT_USER_MAX_ATTEMPTS=1000
OBSERVABILITY_RATE_LIMIT_IP_MAX_ATTEMPTS=2000
OBSERVABILITY_RATE_LIMIT_WINDOW_SECONDS=60

# Synthetic Base USDC values only. Do not use real receiving wallets in local drills.
BASE_RPC_URL=
NODO_CREDIT_RECEIVING_WALLET_BASE=0x1111111111111111111111111111111111111111
ONCHAIN_CREDIT_MIN_CONFIRMATIONS=3
ONCHAIN_CREDIT_PURCHASE_TTL_MINUTES=30
LEGACY_CREDIT_PAYMENT_METHODS_ENABLED=0

# Local private-file adapter for synthetic proof/document uploads.
PRIVATE_STORAGE_MODE=local_file
PRIVATE_STORAGE_ROOT=.local/private_storage
STORAGE_SIGNED_URL_TTL_SECONDS=300

# Frontend public placeholders only.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=nodo_local_test_bot
NEXT_PUBLIC_APP_ENV=local
NEXT_PUBLIC_OBSERVABILITY_INGEST_ENABLED=0
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
