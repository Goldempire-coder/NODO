# NODO slice_00_foundation environment template.
# Keep real values in the deployment provider or local ignored .env files.

APP_ENV=local
APP_NAME=NODO
APP_VERSION=0.0.0-slice-00
NODO_BUILD_ID=local-slice-00
# Production: set the exact official frontend origins (comma-separated).
# When omitted in production, no cross-origin browser access is allowed.
# Wildcard '*' and nodo-staging.pages.dev (including previews) are rejected in production.
API_CORS_ORIGINS=http://localhost:3000
# Optional, only for local/dev/development/staging/test. Unset keeps staging previews;
# empty disables regex matching. Production ignores it and uses API_CORS_ORIGINS only.
# API_CORS_ORIGIN_REGEX=^https://[a-z0-9-]+\.nodo-staging\.pages\.dev$
DATABASE_URL=postgresql://nodo_user:nodo_password@localhost:5432/nodo
NODO_DB_POOL_MAX_SIZE=20
NODO_DB_POOL_TIMEOUT_SECONDS=10
NODO_DB_POOL_WARM_SIZE=8
REDIS_URL=redis://localhost:6379/0
BOT_TOKEN=
BUSINESS_INTAKE_BOT_TOKEN=
NODO_ADMIN_TELEGRAM_BOT_TOKEN=
JWT_SECRET=
JWT_REFRESH_SECRET=
AUTH_INIT_DATA_MAX_AGE_SECONDS=86400
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
AUTH_RATE_LIMIT_MAX_ATTEMPTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
BUSINESS_RATE_LIMIT_MAX_ATTEMPTS=30
BUSINESS_RATE_LIMIT_WINDOW_SECONDS=60
CHAT_MESSAGE_RATE_LIMIT_MAX_ATTEMPTS=10
CHAT_MESSAGE_RATE_LIMIT_WINDOW_SECONDS=60
CHAT_DUPLICATE_MESSAGE_RATE_LIMIT_MAX_ATTEMPTS=2
CHAT_DUPLICATE_MESSAGE_RATE_LIMIT_WINDOW_SECONDS=60
CHAT_ATTACHMENT_RATE_LIMIT_MAX_ATTEMPTS=6
CHAT_ATTACHMENT_RATE_LIMIT_WINDOW_SECONDS=60
SUPPORT_MESSAGE_RATE_LIMIT_MAX_ATTEMPTS=10
SUPPORT_MESSAGE_RATE_LIMIT_WINDOW_SECONDS=60
SUPPORT_DUPLICATE_MESSAGE_RATE_LIMIT_MAX_ATTEMPTS=2
SUPPORT_DUPLICATE_MESSAGE_RATE_LIMIT_WINDOW_SECONDS=60
SUPPORT_ATTACHMENT_RATE_LIMIT_MAX_ATTEMPTS=6
SUPPORT_ATTACHMENT_RATE_LIMIT_WINDOW_SECONDS=60
MARKETPLACE_RATE_LIMIT_MAX_ATTEMPTS=30
MARKETPLACE_RATE_LIMIT_IP_MAX_ATTEMPTS=120
MARKETPLACE_RATE_LIMIT_WINDOW_SECONDS=60
MARKETPLACE_CACHE_TTL_SECONDS=30
MARKETPLACE_READ_AUTH_CLAIM_TTL_SECONDS=300
AUTH_USER_CACHE_TTL_SECONDS=2
API_THREAD_LIMIT=40
OBSERVABILITY_INGEST_ENABLED=0
OBSERVABILITY_MAX_EVENTS_PER_BATCH=20
OBSERVABILITY_MAX_EVENT_BYTES=2048
OBSERVABILITY_RATE_LIMIT_USER_MAX_ATTEMPTS=30
OBSERVABILITY_RATE_LIMIT_IP_MAX_ATTEMPTS=120
OBSERVABILITY_RATE_LIMIT_WINDOW_SECONDS=60

# Base USDC credit purchases. Wallet is public; RPC URL stays backend-only.
BASE_RPC_URL=
# Backend-only reserved RPC credential; current RPC requests use BASE_RPC_URL.
# Leave empty unless a separately approved adapter requires it. Never expose to the web.
BASE_RPC_API_KEY=
NODO_CREDIT_PAYMENT_NETWORK=
NODO_CREDIT_PAYMENT_CONTRACT_ADDRESS=
NODO_CREDIT_PAYMENT_CONTRACT_VERSION=
NODO_CREDIT_PAYMENT_CONTRACT_PAUSED=1
NODO_CREDIT_AUTH_SIGNER_KEY=
NODO_CREDIT_AUTH_SIGNER_ADDRESS=
NODO_CREDIT_AUTH_SIGNER_VERSION=
NODO_CREDIT_RECEIVING_WALLET_BASE=
ONCHAIN_CREDIT_AUTHORIZATION_TTL_MINUTES=15
ONCHAIN_CREDIT_MIN_CONFIRMATIONS=6
ONCHAIN_CREDIT_PURCHASE_TTL_MINUTES=30
ONCHAIN_CREDIT_WATCHER_ENABLED=0
ONCHAIN_CREDIT_WATCHER_INTERVAL_SECONDS=30
ONCHAIN_CREDIT_WATCHER_BATCH_SIZE=50
ONCHAIN_CREDIT_WATCHER_TIMEOUT_SECONDS=10
ONCHAIN_CREDIT_CONTRACT_WATCHER_LOOKBACK_BLOCKS=5000
CREDIT_CONTRACT_RATE_LIMIT_USER_MAX_ATTEMPTS=5
CREDIT_CONTRACT_RATE_LIMIT_BUSINESS_MAX_ATTEMPTS=5
CREDIT_CONTRACT_RATE_LIMIT_IP_MAX_ATTEMPTS=20
CREDIT_CONTRACT_RATE_LIMIT_WINDOW_SECONDS=600
CREDIT_CONTRACT_PENDING_PURCHASE_LIMIT=3
LEGACY_CREDIT_PAYMENT_METHODS_ENABLED=0

# Telegram Mini Apps and order notifications.
# Both URLs must be set explicitly and nonblank when APP_ENV=production.
# Replace local/staging examples with approved production URLs before deployment.
# Outside production, unset values retain the existing staging defaults.
TELEGRAM_WEB_APP_URL=http://localhost:3000
# TELEGRAM_WELCOME_IMAGE_URL=https://nodo-staging.pages.dev/telegram-welcome.jpg?v=20260818143000
ORDER_NOTIFICATION_SENDER_ENABLED=1
ORDER_NOTIFICATION_SENDER_INTERVAL_SECONDS=10
ORDER_NOTIFICATION_SENDER_BATCH_SIZE=50

# Legacy Stripe credit path. Keep disabled for Business Mini App unless explicitly approved.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Private-file storage. Local default is unavailable unless a slice enables a concrete adapter.
PRIVATE_STORAGE_MODE=unavailable
PRIVATE_STORAGE_ROOT=.local/private_storage
STORAGE_SIGNED_URL_TTL_SECONDS=300
# Both values are required only when PRIVATE_STORAGE_MODE=supabase.
# Service-role credential is backend-only; never use a NEXT_PUBLIC_ prefix.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=
NEXT_PUBLIC_APP_ENV=local
# Public build-time CSV of exact HTTPS origins for MetaMask links; never secrets.
# Required for production: empty or malformed denies opening both wallet routes.
# No wildcards, credentials, paths, queries, fragments, or staging hosts in production.
# Empty retains staging only in local/dev/development/staging/test (or next dev).
# HTTP loopback is allowed only in those non-production environments.
# Changing these public values requires rebuilding the web app.
# NEXT_PUBLIC_WALLET_ALLOWLIST=https://nodo.example
NEXT_PUBLIC_OBSERVABILITY_INGEST_ENABLED=0
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
