# NODO staging environment template.
# Do not commit real values. Configure secrets in Railway, Cloudflare Pages, Supabase, Upstash, Stripe and Telegram provider dashboards.

APP_ENV=staging
APP_NAME=NODO
APP_VERSION=
NODO_BUILD_ID=
API_CORS_ORIGINS=https://<cloudflare-pages-domain>

# Railway backend-only
DATABASE_URL=
NODO_DB_POOL_MAX_SIZE=50
NODO_DB_POOL_TIMEOUT_SECONDS=20
NODO_DB_POOL_WARM_SIZE=8
REDIS_URL=
BOT_TOKEN=
BUSINESS_INTAKE_BOT_TOKEN=
JWT_SECRET=
JWT_REFRESH_SECRET=
AUTH_INIT_DATA_MAX_AGE_SECONDS=86400
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
AUTH_RATE_LIMIT_MAX_ATTEMPTS=1000
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
BUSINESS_RATE_LIMIT_MAX_ATTEMPTS=1000
BUSINESS_RATE_LIMIT_WINDOW_SECONDS=60
MARKETPLACE_CACHE_TTL_SECONDS=30
MARKETPLACE_READ_AUTH_CLAIM_TTL_SECONDS=300
AUTH_USER_CACHE_TTL_SECONDS=2
API_THREAD_LIMIT=40

# Stripe test mode first
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=
STRIPE_PRICE_ENTERPRISE=
STRIPE_SUCCESS_URL=https://<cloudflare-pages-domain>/credits/success
STRIPE_CANCEL_URL=https://<cloudflare-pages-domain>/credits/cancel

# Storage: choose Supabase Storage for this staging slice, or Cloudflare R2 in a future adapter
PRIVATE_STORAGE_MODE=supabase
STORAGE_SIGNING_SECRET=
STORAGE_SIGNED_URL_TTL_SECONDS=300

# Cloudflare R2 backend-only
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=

# Supabase Storage backend-only, if selected
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET_BUSINESS_VERIFICATION=business-verification
SUPABASE_STORAGE_BUCKET_PAYMENT_EVIDENCE=payment-evidence
SUPABASE_STORAGE_BUCKET_CREDIT_PURCHASE_PROOFS=credit-purchase-proofs
SUPABASE_STORAGE_BUCKET_MESSAGE_ATTACHMENTS=message-attachments

# Cloudflare Pages public-only
NEXT_PUBLIC_API_BASE_URL=https://<railway-api-domain>/api/v1
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=
NEXT_PUBLIC_APP_ENV=staging
